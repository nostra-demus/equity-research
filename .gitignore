# Root-level data/ is a symlink to the Google Drive research pool (setup step 4).
# Never track or clobber it — a plain dir here is the "0 companies" trap.
/data
/data.plain-bak-*
.cache
.DS_Store
**/.DS_Store

# Engine secrets (§28) — GitHub App identity AND LLM provider API keys. The real ones live in
# ~/.config/nostra-engine (outside the repo, loaded by src/load-env.ts); these are guards so a stray
# copy of a private key, the App env, or a provider-keys file can never be committed by accident.
*.pem
github-app.env
providers.env
.token-cache
nostra-engine/

# Local module-audit scratch — single-file consolidated views used to edit the
# agent prompts; canonical content is tracked under .claude/agents/. Kept on
# disk, out of version control.
/*_audit.md
/*_audit.txt
/*_audit.pdf

# python tool venvs (recreate via .claude/tools/setup-tools.sh)
.venv/

# generated cockpit snapshot — rebuilt by `npm run build` (build-snapshot.mjs); never commit build output (footgun fix)
ui/web/public/data/

# regenerable pool extracts (rebuilt by extract_pool.py) — never commit
_pool_extracts/
**/_pool_extracts/

# regenerable OCR cache (rebuilt by extract_pool.py from image-only/scanned PDFs) — never commit
.claude/tools/.ocr-cache/

# transient defer-module-memos marker (written by the per-module chain, removed at run end / on failure) — never commit
**/.defer_module_memos

# python bytecode cache
__pycache__/
*.pyc

# transient agent-tool git worktrees (isolation:"worktree") — never commit
.claude/worktrees/

# Cloudflare wrangler local cache (account info / build cache) — never commit
.wrangler/

# transient per-PID atomic-write temp files for the screener board index — update_board_index.py
# writes index.json.tmp.<pid> then os.replace()s it onto index.json (never meant to be tracked;
# they only survive on the rare crash between write and rename) — never commit
screener/board/index.json.tmp.*

# Transient cross-process Ideas locks/reservations. They coordinate runtime writes but are never research data.
screener/ledger/ideas/*.json.lock
screener/ledger/ideas/*.promotion
screener/ledger/.qualified-idea-outcomes-pass.flock
