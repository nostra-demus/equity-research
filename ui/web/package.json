{
  "name": "swarm-cockpit-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Minimal-luxe animated swarm UI for the equity-research engine",
  "scripts": {
    "dev": "node scripts/build-snapshot.mjs && vite",
    "build": "node scripts/build-snapshot.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "snapshot": "node scripts/build-snapshot.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "docx": "^9.7.1",
    "framer-motion": "^11.11.17",
    "marked": "^18.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "three": "^0.169.0",
    "web-vitals": "^6.2.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
