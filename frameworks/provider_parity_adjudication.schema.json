{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "frameworks/provider_parity_adjudication.schema.json",
  "title": "Evidence adjudication for material Claude/Codex parity triggers",
  "type": "object",
  "required": ["schema_version", "comparison_id", "execution_receipt", "trigger_adjudications"],
  "properties": {
    "schema_version": { "const": "provider-parity-adjudication/2.0" },
    "comparison_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "execution_receipt": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "trigger_adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger_id", "classification", "evidence"],
        "properties": {
          "trigger_id": { "type": "string", "minLength": 1 },
          "classification": { "type": "string", "enum": ["source_supported_disagreement", "provider_defect"] },
          "defect_class": {
            "type": "string",
            "enum": ["missed_instruction", "missed_source", "missed_hard_cap", "missed_red_flag", "scenario_math", "missed_tool_step", "unsupported_claim", "other"]
          },
          "defective_run": { "type": "string", "enum": ["run_a", "run_b", "both"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["artifact_path", "artifact_sha256", "locator", "finding", "supports"],
              "properties": {
                "artifact_path": { "type": "string", "minLength": 1 },
                "artifact_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "locator": { "type": "string", "minLength": 1 },
                "finding": { "type": "string", "minLength": 1 },
                "supports": { "type": "string", "enum": ["run_a", "run_b", "both", "contract"] }
              },
              "additionalProperties": false
            }
          },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "classification": { "const": "provider_defect" } } },
            "then": { "required": ["defect_class", "defective_run"] },
            "else": { "not": { "anyOf": [{ "required": ["defect_class"] }, { "required": ["defective_run"] }] } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
