{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "frameworks/provider_parity_freeze.schema.json",
  "title": "Pre-launch frozen-input receipt for a Claude/Codex parity canary",
  "type": "object",
  "required": ["schema_version", "receipt_sha256", "created_at", "subject", "decision_date", "data_snapshot", "price_anchor", "runs"],
  "properties": {
    "schema_version": { "const": "provider-parity-freeze/2.0" },
    "receipt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "subject": { "type": "string", "minLength": 1 },
    "decision_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "data_snapshot": {
      "type": "object",
      "required": ["root", "sha256", "file_count", "bytes", "frozen_at", "files"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "file_count": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "frozen_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*$" },
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "price_anchor": {
      "type": "object",
      "required": ["value", "currency", "as_of", "source"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "type": "string", "minLength": 1 },
        "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["label", "provider", "run_root", "binding", "expected_model", "expected_reasoning_level", "expected_profile_key"],
        "properties": {
          "label": { "type": "string", "enum": ["run_a", "run_b"] },
          "provider": { "type": "string", "enum": ["claude", "codex"] },
          "run_root": { "type": "string", "minLength": 1 },
          "binding": { "type": "string", "minLength": 1 },
          "expected_model": { "type": "string", "minLength": 1 },
          "expected_reasoning_level": { "type": "string", "minLength": 1 },
          "expected_profile_key": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
