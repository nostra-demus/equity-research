{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "frameworks/memory/claim-v1.schema.json",
  "title": "Canonical memory claim payload v1",
  "description": "A qualified subject-predicate-object/value assertion. Supported claims cite evidence; inference and not-proven are explicit first-class statuses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "subject_id",
    "predicate",
    "unit",
    "currency",
    "accounting_standard",
    "period",
    "scope",
    "qualifier",
    "basis",
    "epistemic_status",
    "claim_quality",
    "evidence_refs",
    "derived_from_claims",
    "material"
  ],
  "properties": {
    "schema": { "const": "memory-claim/v1" },
    "claim_id": { "$ref": "#/$defs/claimId" },
    "subject_id": { "$ref": "#/$defs/subjectId" },
    "predicate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "object_id": { "$ref": "#/$defs/memoryRef" },
    "value": {},
    "unit": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
    "currency": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-Z]{3}$" }
      ]
    },
    "accounting_standard": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "label"],
      "properties": {
        "from": { "$ref": "#/$defs/nullableDate" },
        "to": { "$ref": "#/$defs/nullableDate" },
        "label": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consolidation", "segment", "geography", "security_id"],
      "properties": {
        "consolidation": { "enum": ["consolidated", "standalone", "segment", "not-applicable", "unknown"] },
        "segment": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
        "geography": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
        "security_id": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^(?:security:figi:[A-Z0-9]{12}|security:isin:[A-Z]{2}[A-Z0-9]{9}[0-9]|security:mic-ticker:[A-Z0-9]{4}:[A-Z0-9][A-Z0-9.-]{0,31})$"
            }
          ]
        }
      }
    },
    "qualifier": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "basis": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "epistemic_status": { "enum": ["supported", "inference", "not-proven"] },
    "claim_quality": { "type": "integer", "minimum": 0, "maximum": 5 },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "derived_from_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/claimId" }
    },
    "material": { "type": "boolean" }
  },
  "oneOf": [
    {
      "required": ["object_id"],
      "not": { "required": ["value"] }
    },
    {
      "required": ["value"],
      "not": { "required": ["object_id"] }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": { "epistemic_status": { "const": "supported" } },
        "required": ["epistemic_status"]
      },
      "then": {
        "properties": {
          "evidence_refs": { "minItems": 1 },
          "claim_quality": { "minimum": 2 }
        }
      }
    },
    {
      "if": {
        "properties": { "epistemic_status": { "const": "inference" } },
        "required": ["epistemic_status"]
      },
      "then": {
        "properties": { "claim_quality": { "maximum": 1 } }
      }
    },
    {
      "if": {
        "properties": { "epistemic_status": { "const": "not-proven" } },
        "required": ["epistemic_status"]
      },
      "then": {
        "properties": { "claim_quality": { "const": 0 } }
      }
    }
  ],
  "$defs": {
    "uuidSuffix": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^claim_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "subjectId": {
      "type": "string",
      "pattern": "^(?:issuer:lei:[A-Z0-9]{20}|security:figi:[A-Z0-9]{12}|security:isin:[A-Z]{2}[A-Z0-9]{9}[0-9]|security:mic-ticker:[A-Z0-9]{4}:[A-Z0-9][A-Z0-9.-]{0,31}|entity:internal:[a-z0-9][a-z0-9._-]{0,127})$"
    },
    "memoryRef": {
      "type": "string",
      "pattern": "^(?:issuer:lei:[A-Z0-9]{20}|security:figi:[A-Z0-9]{12}|security:isin:[A-Z]{2}[A-Z0-9]{9}[0-9]|security:mic-ticker:[A-Z0-9]{4}:[A-Z0-9][A-Z0-9.-]{0,31}|entity:internal:[a-z0-9][a-z0-9._-]{0,127}|(?:evt|run|claim|forecast|rel)_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|source:sha256:[0-9a-f]{64}|evidence:sha256:[0-9a-f]{64}#[A-Za-z0-9][A-Za-z0-9._~:/?&=,+-]{0,255})$"
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^evidence:sha256:[0-9a-f]{64}#[A-Za-z0-9][A-Za-z0-9._~:/?&=,+-]{0,255}$"
    },
    "nullableDate": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      ]
    }
  }
}
