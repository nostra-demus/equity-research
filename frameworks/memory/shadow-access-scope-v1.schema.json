{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "frameworks/memory/shadow-access-scope-v1.schema.json",
  "title": "Trusted out-of-band shadow server access scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope_id",
    "policy_version",
    "classifications",
    "source_tiers",
    "embedding_classifications",
    "entitlement_ids"
  ],
  "properties": {
    "schema": { "const": "memory-shadow-access-scope/v1" },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "classifications": { "$ref": "#/$defs/classifications" },
    "source_tiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 10 }
    },
    "embedding_classifications": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/classification" }
    },
    "entitlement_ids": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "$defs": {
    "classification": {
      "enum": ["public", "internal", "licensed", "confidential", "restricted"]
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/classification" }
    }
  }
}
