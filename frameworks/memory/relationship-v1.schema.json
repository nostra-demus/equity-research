{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "frameworks/memory/relationship-v1.schema.json",
  "title": "Canonical memory relationship payload v1",
  "description": "A typed, append-only edge between two memory records. Conflicts and supersession remain explicit edges instead of deleting the losing record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "relationship_id",
    "relationship_type",
    "source_ref",
    "target_ref",
    "qualifier",
    "evidence_refs"
  ],
  "properties": {
    "schema": { "const": "memory-relationship/v1" },
    "relationship_id": {
      "type": "string",
      "pattern": "^rel_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "relationship_type": {
      "enum": [
        "supports",
        "contradicts",
        "qualifies",
        "derived_from",
        "supersedes",
        "same_as",
        "about",
        "resolved_by"
      ]
    },
    "source_ref": { "$ref": "#/$defs/memoryRef" },
    "target_ref": { "$ref": "#/$defs/memoryRef" },
    "qualifier": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceRef" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "relationship_type": { "enum": ["same_as", "supersedes"] }
        },
        "required": ["relationship_type"]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "source_ref": { "$ref": "#/$defs/eventRef" },
              "target_ref": { "$ref": "#/$defs/eventRef" }
            }
          },
          {
            "properties": {
              "source_ref": { "$ref": "#/$defs/runRef" },
              "target_ref": { "$ref": "#/$defs/runRef" }
            }
          },
          {
            "properties": {
              "source_ref": { "$ref": "#/$defs/claimRef" },
              "target_ref": { "$ref": "#/$defs/claimRef" }
            }
          },
          {
            "properties": {
              "source_ref": { "$ref": "#/$defs/forecastRef" },
              "target_ref": { "$ref": "#/$defs/forecastRef" }
            }
          },
          {
            "properties": {
              "source_ref": { "$ref": "#/$defs/relationshipRef" },
              "target_ref": { "$ref": "#/$defs/relationshipRef" }
            }
          },
          {
            "properties": {
              "source_ref": { "$ref": "#/$defs/sourceRef" },
              "target_ref": { "$ref": "#/$defs/sourceRef" }
            }
          },
          {
            "properties": {
              "source_ref": { "$ref": "#/$defs/evidenceRef" },
              "target_ref": { "$ref": "#/$defs/evidenceRef" }
            }
          },
          {
            "properties": {
              "source_ref": { "$ref": "#/$defs/identityRef" },
              "target_ref": { "$ref": "#/$defs/identityRef" }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "eventRef": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runRef": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "claimRef": {
      "type": "string",
      "pattern": "^claim_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "forecastRef": {
      "type": "string",
      "pattern": "^forecast_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "relationshipRef": {
      "type": "string",
      "pattern": "^rel_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^source:sha256:[0-9a-f]{64}$"
    },
    "identityRef": {
      "type": "string",
      "pattern": "^(?:issuer:lei:[A-Z0-9]{20}|security:figi:[A-Z0-9]{12}|security:isin:[A-Z]{2}[A-Z0-9]{9}[0-9]|security:mic-ticker:[A-Z0-9]{4}:[A-Z0-9][A-Z0-9.-]{0,31}|entity:internal:[a-z0-9][a-z0-9._-]{0,127})$"
    },
    "memoryRef": {
      "type": "string",
      "pattern": "^(?:issuer:lei:[A-Z0-9]{20}|security:figi:[A-Z0-9]{12}|security:isin:[A-Z]{2}[A-Z0-9]{9}[0-9]|security:mic-ticker:[A-Z0-9]{4}:[A-Z0-9][A-Z0-9.-]{0,31}|entity:internal:[a-z0-9][a-z0-9._-]{0,127}|(?:evt|run|claim|forecast|rel)_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|source:sha256:[0-9a-f]{64}|evidence:sha256:[0-9a-f]{64}#[A-Za-z0-9][A-Za-z0-9._~:/?&=,+-]{0,255})$"
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^evidence:sha256:[0-9a-f]{64}#[A-Za-z0-9][A-Za-z0-9._~:/?&=,+-]{0,255}$"
    }
  }
}
