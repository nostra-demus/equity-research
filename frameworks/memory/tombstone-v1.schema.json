{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "frameworks/memory/tombstone-v1.schema.json",
  "title": "Canonical memory tombstone payload v1",
  "description": "A policy-safe, non-content marker that suppresses exactly one prior event. It deliberately has no free-form text fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_event_id",
    "reason_code",
    "basis",
    "basis_id"
  ],
  "properties": {
    "schema": { "const": "memory-tombstone/v1" },
    "target_event_id": { "$ref": "#/$defs/eventId" },
    "reason_code": {
      "enum": [
        "administrative-revocation",
        "integrity-revocation",
        "legal-erasure",
        "licence-withdrawn",
        "privacy-erasure",
        "retention-ended"
      ]
    },
    "basis": {
      "enum": [
        "data-subject-request",
        "integrity-policy",
        "legal-obligation",
        "licence-policy",
        "retention-policy"
      ]
    },
    "basis_id": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/basisId" }
      ]
    }
  },
  "$defs": {
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "basisId": {
      "type": "string",
      "pattern": "^(?:basis_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|basis:sha256:[0-9a-f]{64})$",
      "maxLength": 77
    }
  }
}
