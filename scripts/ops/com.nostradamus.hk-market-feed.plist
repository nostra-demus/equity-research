<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Machine-agnostic TEMPLATE: placeholder tokens rendered by scripts/ops/install-services.sh at install time.
     DOER-ONLY daily refresh of the S&P 500 benchmark feed (scripts/fetch_market_feed.py -> data/_market/fred/).
     Deterministic; invokes no model and consumes neither Claude nor Codex quota. Scheduled ahead of
     hk-calibrate-daily (07:25) so that day's calibration and any decision review read a fresh close instead
     of falling back to an ad-hoc web-sourced price. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.nostradamus.hk-market-feed</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>{{HOME}}/.nostra-ops/market-feed-local.sh</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PATH</key><string>{{PLIST_PATH}}</string>
    <key>ENGINE_REPO_ROOT</key><string>{{ENGINE_REPO_ROOT}}</string>
  </dict>
  <key>MaterializeDatalessFiles</key><true/>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/nostradamus-housekeeping.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/nostradamus-housekeeping.log</string>
</dict></plist>
