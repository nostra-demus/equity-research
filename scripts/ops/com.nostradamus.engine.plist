<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Machine-agnostic TEMPLATE: placeholder tokens are rendered to this host's real paths by
     scripts/ops/install-services.sh at install time (any home / Intel OR Apple-Silicon brew). -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.nostradamus.engine</string>
  <!-- Launch node DIRECTLY (not `npm start` → tsx) so launchctl's SIGTERM on `kickstart -k` reaches THIS
       process, whose graceful-shutdown handler (ui/server/src/server.ts) drains SSE + closes keep-alive
       sockets cleanly before exit. Through npm/tsx the signal is not forwarded — node is SIGKILLed, dropping
       every in-flight connection (a reset cloudflared reports as a 502). `--import tsx` runs the TS source
       straight from src/ (the live API == main), resolved from ui/server/node_modules via WorkingDirectory. -->
  <key>ProgramArguments</key><array><string>{{NODE_BIN}}</string><string>--import</string><string>tsx</string><string>src/server.ts</string></array>
  <key>WorkingDirectory</key><string>{{ENGINE_REPO_ROOT}}/ui/server</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>{{PLIST_PATH}}</string>
    <key>HOME</key><string>{{HOME}}</string>
    <key>ENGINE_FULL_PER_MODULE</key><string>1</string>
    <key>ENGINE_REPO_ROOT</key><string>{{ENGINE_REPO_ROOT}}</string>
    <key>ENGINE_STATE_DIR</key><string>{{STATE_DIR}}</string>
    <key>SCREENER_AUTOTUNE_ENABLED</key><string>1</string></dict>
  <!-- The data pool lives in Google Drive (Stream mode): ticker files are dataless placeholders that
       download on read. A launchd job inherits the materialize-dataless policy OFF by default, so the
       engine's reads of streamed filings would fail (0 bytes + EDEADLK). This opts the engine in so it
       downloads file contents on access. See launchd.plist(5) / setiopolicy_np(3). -->
  <key>MaterializeDatalessFiles</key><true/>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/nostradamus-engine.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/nostradamus-engine.log</string>
</dict></plist>
