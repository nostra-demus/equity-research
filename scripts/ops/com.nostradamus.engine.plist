<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Machine-agnostic TEMPLATE: placeholder tokens are rendered to this host's real paths by
     scripts/ops/install-services.sh at install time (any home / Intel OR Apple-Silicon brew). -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.nostradamus.engine</string>
  <!-- Launch node DIRECTLY (not `npm start` → tsx) so launchctl's SIGTERM on `kickstart -k` reaches THIS
       process, whose graceful-shutdown handler (ui/server/src/server.ts) drains SSE + closes keep-alive
       sockets cleanly before exit. Through npm/tsx the signal is not forwarded — node is SIGKILLed, dropping
       every in-flight connection (a reset cloudflared reports as a 502). `--import tsx` runs the TS source
       straight from src/ (the live API == main), resolved from ui/server/node_modules via WorkingDirectory. -->
  <key>ProgramArguments</key><array><string>{{NODE_BIN}}</string><string>--import</string><string>tsx</string><string>src/server.ts</string></array>
  <key>WorkingDirectory</key><string>{{ENGINE_REPO_ROOT}}/ui/server</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>{{PLIST_PATH}}</string>
    <key>HOME</key><string>{{HOME}}</string>
    <key>ENGINE_FULL_PER_MODULE</key><string>1</string>
    <key>ENGINE_REPO_ROOT</key><string>{{ENGINE_REPO_ROOT}}</string>
    <key>ENGINE_STATE_DIR</key><string>{{STATE_DIR}}</string>
    <key>SCREENER_AUTOTUNE_ENABLED</key><string>1</string>
    <!-- One automatic research owner. The installer renders 1 only on the permanent doer that is also the
         connector writer. Admin engines and a serving-only failover render 0, so they can never duplicate
         paid research. INTAKE scopes changed evidence; CALL_UPDATE executes its committed exact plan;
         REVIEW files due outcomes; CONVICTION checks the screener's due checkpoints. -->
    <key>INTAKE_AUTO_ANALYZE</key><string>{{AUTOMATION_OWNER}}</string>
    <key>CALL_UPDATE_AUTO_ENABLED</key><string>{{AUTOMATION_OWNER}}</string>
    <key>REVIEW_DISPATCH_ENABLED</key><string>{{AUTOMATION_OWNER}}</string>
    <key>CONVICTION_LOOP_ENABLED</key><string>{{AUTOMATION_OWNER}}</string>
    <!-- The company-news bridge (#359). BRIDGE_MODE is authoritative and the code ships OFF: an UNSET
         variable reads as 'off', so the installed service never ran the 12-hourly sweep even after the
         feature merged — the API reported "off" while the manifest listed covered subjects, and the only
         way to see it work was to start a server by hand with the variable set. Turn it on where the
         service is actually defined, beside the other loops this file enables.
         'batch' = the in-cockpit sweep (bridge-scheduler.ts). Cadence is left at its 12h default;
         BRIDGE_INTERVAL_MIN overrides it (clamped 15m-7d) and is for testing, not for this file.
         Cost note (§24): a routed note first triggers the cheap intake analysis. The automatic owner then
         runs only the exact affected orbs recorded in that committed plan.
         {{BRIDGE_MODE}} is rendered by install-services.sh, NOT hardcoded: 'batch' by default on a
         fresh permanent-owner install, 'off' unconditionally on an admin or serving-only failover (this
         file is a BASE service installed on every role, so another machine must not inherit routing —
         same "no duplicate autonomy" reasoning as the doer-only agents get from being installed only
         on the doer role), and an operator's prior explicit choice (off/stream) on a doer machine is
         carried forward across reinstall instead of being silently reset. See install-services.sh's
         BRIDGE_MODE_VALUE computation + render() for the exact logic. -->
    <key>BRIDGE_MODE</key><string>{{BRIDGE_MODE}}</string></dict>
  <!-- The data pool lives in Google Drive (Stream mode): ticker files are dataless placeholders that
       download on read. A launchd job inherits the materialize-dataless policy OFF by default, so the
       engine's reads of streamed filings would fail (0 bytes + EDEADLK). This opts the engine in so it
       downloads file contents on access. See launchd.plist(5) / setiopolicy_np(3). -->
  <key>MaterializeDatalessFiles</key><true/>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/nostradamus-engine.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/nostradamus-engine.log</string>
</dict></plist>
