<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Machine-agnostic TEMPLATE: placeholder tokens rendered by scripts/ops/install-services.sh at install time.
     DOER-ONLY: only the always-on host sweeps the shared Drive pool — two machines running the same
     connectors would race on the run ledger and double-fetch. Every 6 hours (and once at load) it runs
     the self-heal connector runner (.claude/tools/run_connectors.py): each .claude/connectors/<id>/
     manifest's pool series is checked against its own staleness_sla_days and fetch.py re-runs ONLY when
     the series is missing or past SLA — a fresh pool is a no-op sweep, so the 6h interval is safe for
     weekly/monthly cadences. A failed fetch writes nothing (the fetcher contract); the stale pool IS the
     alert, surfaced by the cockpit Data Library. MaterializeDatalessFiles is REQUIRED — the pool is a
     Google Drive CloudStorage mount and a launchd job cannot read streamed (dataless) files without it. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nostradamus.connectors</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>{{HOME}}</string>
		<key>PATH</key>
		<string>{{PLIST_PATH}}</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>{{ENGINE_REPO_ROOT}}</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/env</string>
		<string>python3</string>
		<string>{{ENGINE_REPO_ROOT}}/.claude/tools/run_connectors.py</string>
		<string>--data-root</string>
		<string>{{ENGINE_REPO_ROOT}}/data</string>
	</array>
	<key>MaterializeDatalessFiles</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/nostradamus-connectors.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/nostradamus-connectors.log</string>
	<key>ThrottleInterval</key>
	<integer>60</integer>
</dict>
</plist>
