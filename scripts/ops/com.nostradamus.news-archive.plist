<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Machine-agnostic TEMPLATE: placeholder tokens rendered by scripts/ops/install-services.sh at install time.
     DOER-ONLY: only the always-on host archives to Drive — two machines writing the same Drive folder race.
     NEWS_ARCHIVE_DIR is set at install time (env/arg); if empty, news-archive.sh no-ops (no cloud archive).
     Every 3 hours (and once at load) it COPIES the raw-news firehose files into a Google Drive for Desktop
     mount folder (Drive uploads them to the cloud — no rclone/API needed) and prunes local copies older
     than the retention window, keeping disk bounded. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nostradamus.news-archive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>REPO</key>
		<string>{{ENGINE_REPO_ROOT}}</string>
		<key>NEWS_ARCHIVE_DIR</key>
		<string>{{NEWS_ARCHIVE_DIR}}</string>
		<key>ENGINE_STATE_DIR</key>
		<string>{{STATE_DIR}}</string>
		<key>NODE_BIN</key>
		<string>{{NODE_BIN}}</string>
		<key>NEWS_LOCAL_RETENTION_DAYS</key>
		<string>30</string>
		<key>HOME</key>
		<string>{{HOME}}</string>
		<key>PATH</key>
		<string>{{PLIST_PATH}}</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ENGINE_REPO_ROOT}}/scripts/ops/news-archive.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>10800</integer>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/nostradamus-news-archive.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/nostradamus-news-archive.log</string>
	<key>ThrottleInterval</key>
	<integer>60</integer>
</dict>
</plist>
