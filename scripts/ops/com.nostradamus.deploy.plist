<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Machine-agnostic TEMPLATE: placeholder tokens rendered by scripts/ops/install-services.sh at install time. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.nostradamus.deploy</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>{{HOME}}/.nostra-ops/deploy.sh</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>{{PLIST_PATH}}</string>
    <key>HOME</key><string>{{HOME}}</string>
    <key>ENGINE_REPO_ROOT</key><string>{{ENGINE_REPO_ROOT}}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>120</integer>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/nostradamus-deploy.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/nostradamus-deploy.log</string>
</dict></plist>
