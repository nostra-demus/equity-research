<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Machine-agnostic TEMPLATE: placeholder tokens rendered by scripts/ops/install-services.sh at install time.
     Autonomous news ingester as a standalone launchd service (the "true 24/7" hosting mode, runs
     independently of whether the cockpit UI is open). DOER-ONLY: only the always-on host should ingest,
     or two machines double-fill the inbox. It fires one ingest cycle every StartInterval seconds:
     pull GDELT → Groq-triage → fill the ranked inbox. It NEVER launches a paid Claude run.
     Opt-in: replace __SET_YOUR_GROQ_API_KEY__ below with your free Groq key, then run
     scripts/ops/install-services.sh (it installs this service only once the placeholder is gone). -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.nostradamus.news-ingester</string>
  <key>ProgramArguments</key><array><string>{{NPM_BIN}}</string><string>run</string><string>ingest:once</string></array>
  <key>WorkingDirectory</key><string>{{ENGINE_REPO_ROOT}}/ui/server</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>{{PLIST_PATH}}</string>
    <key>HOME</key><string>{{HOME}}</string>
    <key>GROQ_API_KEY</key><string>__SET_YOUR_GROQ_API_KEY__</string>
    <!-- optional: pin a model id, override caps, etc. -->
    <!-- <key>GROQ_MODEL</key><string>llama-3.1-8b-instant</string> -->
    <!-- optional free OVERFLOW brains (each stays off until its key is set; fill the value, never commit a real key):
         <key>CEREBRAS_API_KEY</key><string>__SET_YOUR_CEREBRAS_API_KEY__</string>
         <key>MISTRAL_API_KEY</key><string>__SET_YOUR_MISTRAL_API_KEY__</string>
         <key>GEMINI_API_KEY</key><string>__SET_YOUR_GEMINI_API_KEY__</string>
         <key>OPENROUTER_API_KEY</key><string>__SET_YOUR_OPENROUTER_API_KEY__</string> -->
  </dict>
  <!-- run one cycle on load, then every 15 minutes. Each run is a single cycle that exits (not a
       long-lived process), so there is no KeepAlive here. -->
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/nostradamus-news-ingester.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/nostradamus-news-ingester.log</string>
</dict></plist>
