    "observations[].markets[].records[].outstanding_sales": "running_bales",
    "observations[].markets[].records[].gross_new_sales": "running_bales",
    "observations[].markets[].records[].current_market_year_net_sales": "running_bales",
    "observations[].markets[].records[].current_market_year_total_commitment": "running_bales",
    "observations[].markets[].records[].next_market_year_outstanding_sales": "running_bales",
