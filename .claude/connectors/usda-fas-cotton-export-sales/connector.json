  "subjects": ["COTTON"],
  "provider": "USDA Foreign Agricultural Service",
  "authority_class": "government_official",
  "provider_priority": 100,
  "acquisition": "free_key_api",
  "source_type": "official_data",
  "tier": 5,
  "license": "us_government_public_domain",
  "licensing": {"access": "public", "use": "allowed", "redistribution": "allowed", "terms_url": "https://apps.fas.usda.gov/opendatawebV2/"},
