{
  "manifest_version": 2,
  "schema_version": 1,
  "id": "bis-wheat-trade-fx",
  "dataset_id": "bis.xru.wheat-exporter-fx",
  "series_id": "wheat.exporter-fx",
  "series": "BIS daily USD exchange rates for Russia, euro area, Australia, Canada and Argentina",
  "satisfies": ["wheat-exporter-fx"],
  "subjects": ["WHEAT"],
  "provider": "Bank for International Settlements",
  "authority_class": "government_official",
  "provider_priority": 100,
  "acquisition": "official_api",
  "source_type": "official_data",
  "tier": 5,
  "license": "BIS statistics permitted use with source citation and BIS conditions",
  "licensing": {"access": "public", "use": "allowed", "redistribution": "allowed", "terms_url": "https://data.bis.org/help/legal"},
  "host_allowlist": ["stats.bis.org"],
  "credential_env": [],
  "release": {"cadence": "daily", "timezone": "Europe/Zurich", "expected_lag_days": 3, "grace_days": 7, "revision_policy": "revisable"},
  "entry": "fetch.py",
  "verify": "fetch.py --verify",
  "output_path": "data/<SUBJECT>/external/bis/wheat_trade_fx_<as_of>.json",
  "output_schema": {
    "series": "string", "as_of": "date", "rate_basis": "string", "currency_pairs": ["string"],
    "observations": [{"date": "date", "rub_per_usd": "float", "eur_per_usd": "float", "aud_per_usd": "float", "cad_per_usd": "float", "ars_per_usd": "float"}],
    "source_url": "string"
  },
  "units": {"observations[].rub_per_usd": "RUB_per_USD", "observations[].eur_per_usd": "EUR_per_USD", "observations[].aud_per_usd": "AUD_per_USD", "observations[].cad_per_usd": "CAD_per_USD", "observations[].ars_per_usd": "ARS_per_USD"},
  "minimum_history": {"observations": 750, "path": "observations"}
}
