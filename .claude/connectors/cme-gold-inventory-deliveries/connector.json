{
  "manifest_version": 2,
  "schema_version": 1,
  "id": "cme-gold-inventory-deliveries",
  "dataset_id": "cme.comex-gold-stocks-deliveries",
  "series_id": "gold.comex-inventory-deliveries",
  "series": "CME COMEX Gold registered/eligible stocks and delivery notices",
  "satisfies": ["gold-comex-inventory-deliveries", "accessible-physical-inventory", "delivery-pressure"],
  "subjects": ["GOLD"],
  "provider": "User-transcribed CME report",
  "authority_class": "other",
  "provider_priority": 100,
  "acquisition": "manual",
  "source_type": "external_other",
  "tier": 9,
  "license": "Manual normalized capture only; context-only evidence. The original CME report is not sealed by this connector and the capture must not be represented as primary exchange evidence.",
  "licensing": {"access": "public", "use": "allowed", "redistribution": "derived_only", "terms_url": "https://www.cmegroup.com/market-data/market-data-licensing.html"},
  "host_allowlist": ["www.cmegroup.com"],
  "credential_env": [],
  "release": {"cadence": "daily", "timezone": "America/Chicago", "expected_lag_days": 1, "grace_days": 3, "revision_policy": "revisable"},
  "manual": true,
  "manual_ingest": {"file_arg": "--from-file"},
  "entry": "fetch.py",
  "verify": "fetch.py --verify",
  "output_path": "data/<SUBJECT>/external/cme/gold_inventory_deliveries_<as_of>.json",
  "output_schema": {
    "series": "string",
    "as_of": "date",
    "registered_ounces": "float",
    "eligible_ounces": "float",
    "total_ounces": "float",
    "received_ounces": "float",
    "shipped_ounces": "float",
    "delivery_notices": "int",
    "delivery_contract": "string",
    "source_report": "string",
    "source_url": "string",
    "manual_source": true
  },
  "units": {
    "registered_ounces": "troy_ounces",
    "eligible_ounces": "troy_ounces",
    "total_ounces": "troy_ounces",
    "received_ounces": "troy_ounces",
    "shipped_ounces": "troy_ounces",
    "delivery_notices": "contracts"
  },
  "minimum_history": {"observations": 1}
}
