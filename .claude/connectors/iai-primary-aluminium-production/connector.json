{
  "manifest_version": 2,
  "schema_version": 1,
  "id": "iai-primary-aluminium-production",
  "dataset_id": "iai.primary-aluminium-production",
  "series_id": "aluminium.primary-production",
  "series": "IAI monthly primary aluminium production — world + China (Estimated), thousand tonnes",
  "satisfies": ["iai-primary-production"],
  "subjects": ["ALUMINIUM"],
  "provider": "IAI",
  "authority_class": "industry_body_official",
  "provider_priority": 100,
  "acquisition": "manual",
  "source_type": "official_data",
  "tier": 5,
  "license": "IAI website material — prior written permission required for institutional use; manual ingest only",
  "licensing": {"access": "restricted", "use": "entitlement_required", "redistribution": "prohibited", "terms_url": "https://international-aluminium.org/terms-conditions/"},
  "host_allowlist": ["international-aluminium.org", "alvis.international-aluminium.org"],
  "credential_env": [],
  "release": {
    "cadence": "monthly",
    "timezone": "UTC",
    "expected_lag_days": 25,
    "grace_days": 20,
    "revision_policy": "revisable"
  },
  "manual": true,
  "manual_ingest": {"file_arg": "--from-file"},
  "entry": "fetch.py",
  "verify": "fetch.py --verify",
  "output_path": "data/<SUBJECT>/external/iai/primary_production_<as_of>.json",
  "output_schema": {
    "series": "string",
    "as_of": "date",
    "unit": "string",
    "months": [{ "month": "YYYY-MM", "world_kt": "float", "china_kt": "float" }],
    "latest": {
      "month": "YYYY-MM",
      "china_kt": "float",
      "world_kt": "float"
    },
    "source_url": "string"
  },
  "units": {
    "months[].world_kt": "kilotonnes",
    "months[].china_kt": "kilotonnes",
    "latest.china_kt": "kilotonnes",
    "latest.world_kt": "kilotonnes"
  },
  "minimum_history": { "observations": 13, "path": "months" }
}
