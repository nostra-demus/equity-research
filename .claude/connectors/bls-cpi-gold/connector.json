{
  "manifest_version": 2,
  "schema_version": 1,
  "id": "bls-cpi-gold",
  "dataset_id": "bls.cuur0000sa0",
  "series_id": "gold.consumer-price-index",
  "series": "US CPI-U all items, not seasonally adjusted",
  "satisfies": ["gold-consumer-price-index", "consumer-price-index"],
  "subjects": ["GOLD"],
  "provider": "U.S. Bureau of Labor Statistics",
  "authority_class": "government_official",
  "provider_priority": 100,
  "acquisition": "official_api",
  "source_type": "official_data",
  "tier": 5,
  "license": "BLS public data; works of the U.S. federal government",
  "licensing": {"access": "public", "use": "allowed", "redistribution": "allowed", "terms_url": "https://www.bls.gov/bls/linksite.htm"},
  "host_allowlist": ["api.bls.gov"],
  "credential_env": [],
  "release": {"cadence": "monthly", "timezone": "America/New_York", "expected_lag_days": 45, "grace_days": 10, "revision_policy": "revisable"},
  "entry": "fetch.py",
  "verify": "fetch.py --verify",
  "output_path": "data/<SUBJECT>/external/bls/consumer_price_index_<as_of>.json",
  "output_schema": {
    "series": "string",
    "as_of": "date",
    "bls_series_id": "string",
    "seasonal_adjustment": "string",
    "observations": [{"date": "date", "index": "float"}],
    "source_urls": ["string"],
    "historical_replay_policy": "string"
  },
  "units": {"observations[].index": "index"},
  "minimum_history": {"observations": 120, "path": "observations"}
}
