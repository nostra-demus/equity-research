{
  "manifest_version": 2,
  "schema_version": 1,
  "id": "wgc-official-gold-reserves",
  "dataset_id": "wgc.imf-ifs-official-gold-reserve-changes",
  "series_id": "gold.official-reserve-changes",
  "series": "Official-sector Gold reserve changes compiled from IMF IFS and central banks",
  "satisfies": ["gold-official-reserve-changes", "official-sector-demand"],
  "subjects": ["GOLD"],
  "provider": "User-transcribed WGC/IMF workbook",
  "authority_class": "other",
  "provider_priority": 100,
  "acquisition": "manual",
  "source_type": "external_other",
  "tier": 9,
  "license": "Manual normalized capture only; context-only evidence. The original WGC/IMF workbook is not sealed by this connector and the capture must not be represented as primary vendor evidence.",
  "licensing": {"access": "public", "use": "allowed", "redistribution": "prohibited", "terms_url": "https://www.gold.org/terms-conditions"},
  "host_allowlist": ["www.gold.org"],
  "credential_env": [],
  "release": {"cadence": "monthly", "timezone": "Europe/London", "expected_lag_days": 70, "grace_days": 15, "revision_policy": "revisable"},
  "manual": true,
  "manual_ingest": {"file_arg": "--from-file"},
  "entry": "fetch.py",
  "verify": "fetch.py --verify",
  "output_path": "data/<SUBJECT>/external/world-gold-council/official_reserve_changes_<as_of>.json",
  "output_schema": {
    "series": "string",
    "as_of": "date",
    "reporting_lag_months": "int",
    "changes": [{"institution": "string", "change_tonnes": "float", "status": "enum:reported|wgc_adjusted"}],
    "net_reported_change_tonnes": "float",
    "net_wgc_adjusted_change_tonnes": "float",
    "net_compiled_change_tonnes": "float",
    "compilation_basis": "string",
    "adjustments_preserved": true,
    "source_url": "string",
    "manual_source": true
  },
  "units": {
    "reporting_lag_months": "months",
    "changes[].change_tonnes": "metric_tonnes",
    "net_reported_change_tonnes": "metric_tonnes",
    "net_wgc_adjusted_change_tonnes": "metric_tonnes",
    "net_compiled_change_tonnes": "metric_tonnes"
  },
  "minimum_history": {"observations": 1}
}
